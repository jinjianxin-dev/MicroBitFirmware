{
    "name": "MicroBitFirmware",
    "version": "0.0.0",
    "description": "MicroBit BLE Controller Firmware",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "microphone": "*"
    },
    "files": [
        "main.ts",
        "README.md",
        "protocol/protocol.ts",
        "protocol/command.ts",
        "protocol/parser.ts",
        "handlers/button.ts",
        "handlers/direction.ts",
        "handlers/number.ts",
        "handlers/system.ts",
        "protocol/response.ts",
        "communication/transport.ts",
        "router/router.ts",
        "core/MBVersion.ts",
        "core/MBConfig.ts",
        "core/MBBoard.ts",
        "core/MBEnums.ts",
        "devices/MBMotor.ts",
        "devices/MBServo.ts"
    ],
    "testFiles": [
        "test.ts"
    ],
    "public": true,
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
