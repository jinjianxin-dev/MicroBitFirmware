{
    "name": "microbit-controller",
    "version": "2.0.0",
    "description": "MicroBit BLE Controller Firmware",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "microphone": "*"
    },
    "files": [
        "main.ts",
        "README.md",
        "protocol/protocol.ts",
        "protocol/command.ts",
        "protocol/parser.ts",
        
        "handlers/direction.ts",
        "handlers/number.ts",
        "handlers/system.ts",
        "protocol/response.ts",
        "communication/transport.ts",
        "router/router.ts",        
        "devices/MBMotor.ts",
        "devices/MBServo.ts",
        "devices/PCA9685.ts",
        "devices/L298N.ts",
        "devices/MBPCA9685Servo.ts"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "extension": true,
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
